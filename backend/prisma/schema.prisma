generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                  String               @id @default(cuid())
  name                String
  location            String
  imageUrl            String
  status              String               @default("Healthy")
  // Meal service windows shown to residents, as 24-hour "HH:MM" local (IST) times.
  breakfastFrom       String               @default("07:30")
  breakfastTo         String               @default("09:30")
  lunchFrom           String               @default("12:30")
  lunchTo             String               @default("14:30")
  dinnerFrom          String               @default("19:30")
  dinnerTo            String               @default("21:30")
  // Who the PG is for; null only for properties created before this was asked.
  tenantType          TenantType?
  // Codes from the known amenity list (see propertyFeatures.ts), so new amenities need no migration.
  amenities           String[]             @default([])
  // Room capacity the owner declared; occupancy is measured against it. Null for older properties,
  // which fall back to the number of Room rows that exist.
  totalRooms          Int?
  // Optional pricing: when both are set, residents' rent follows their food choice (see propertyRent.ts).
  rentWithFood        Int?
  rentWithoutFood     Int?
  rooms               Room[]
  payments            Payment[]
  activities          Activity[]
  maintenanceRequests MaintenanceRequest[]
  bookings            Booking[]
  announcements       Announcement[]
  menuItems           MenuItem[]
  mealFeedback        MealFeedback[]
  createdAt           DateTime             @default(now())
}

model Room {
  id         String    @id @default(cuid())
  number     String
  occupied   Boolean   @default(false)
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  resident   Resident?

  // Room numbers are defined by the owner and must be unique within a property.
  @@unique([propertyId, number])
}

model Resident {
  id                      String                   @id @default(cuid())
  name                    String
  phone                   String?
  email                   String?
  aadharNumber            String?
  permanentAddress        String?
  aadharCardUrl           String?
  accessKeyHash           String?
  // Set by the resident after their first access-key sign-in; from then on the access key is retired.
  passwordHash            String?
  roomId                  String                   @unique
  room                    Room                     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  active                  Boolean                  @default(true)
  // Move-in date, separate from createdAt because residents are often added after they arrive.
  joinedAt                DateTime                 @default(now()) @db.Date
  // Portal content stays locked until an owner approves the resident's Aadhaar details.
  aadharStatus            AadharVerificationStatus @default(NOT_SUBMITTED)
  aadharRejectionReason   String?
  aadharSubmittedAt       DateTime?
  aadharReviewedAt        DateTime?
  // Small square JPEG (resized in the browser) stored as a data URL; the timestamp versions the
  // photo URL so browsers fetch the new one after a change instead of showing a cached copy.
  profilePhotoUrl         String?
  profilePhotoUpdatedAt   DateTime?
  // Whole rupees per month; null means rent is not tracked for this resident.
  monthlyRent             Int?
  // When rent was first set: billing starts from here, so adding rent for an existing resident
  // never produces surprise arrears for months before the owner started tracking.
  rentTrackedFrom         DateTime?
  // Food plan chosen by the owner; residents without it get no menu, skips, or headcount entry.
  foodOpted               Boolean                  @default(true)
  // Set when a resident without food asks to join the food plan; cleared when the owner decides.
  foodRequestedAt         DateTime?
  sessions                Session[]
  housekeepingRequests    HousekeepingRequest[]
  rentPayments            RentPayment[]
  payments                Payment[]
  bookings                Booking[]
  rentOrders              RentOrder[]
  mealSkips               MealSkip[]
  // The policy version (latest update timestamp) this resident accepted, and when they did.
  policiesAcceptedVersion DateTime?
  policiesAcceptedAt      DateTime?
  mealFeedback            MealFeedback[]
  createdAt               DateTime                 @default(now())
}

// A payment the owner records by hand. Amount is in whole rupees. Payer name and phone are copied
// from the resident at entry time (and editable), so the record still reads correctly after the
// resident moves out or their details change; residentId is only a link back.
model Payment {
  id                String    @id @default(cuid())
  amount            Int
  status            String    @default("paid")
  payerName         String    @default("")
  phone             String    @default("")
  bankName          String    @default("")
  method            String    @default("cash")
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residentId        String?
  resident          Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  // Set when the payment is collected through a Razorpay UPI QR code; Razorpay then decides the
  // status (paid on credit, failed when the code closes unpaid), not the owner.
  razorpayQrId      String?   @unique
  qrImageUrl        String?
  qrExpiresAt       DateTime?
  razorpayPaymentId String?
  // A resident's "I've paid" report for a payment to the owner's UPI ID: the UPI reference (UTR)
  // they entered, and the rent months it covers ([{ month, amount }]), recorded when the owner
  // marks it paid.
  reference         String    @default("")
  rentMonths        Json?
  createdAt         DateTime  @default(now())
}

model MaintenanceRequest {
  id         String   @id @default(cuid())
  title      String
  status     String   @default("open")
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String
  amountLabel String
  timeLabel   String
  tone        String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// A booking request, mostly from the public /book form shared on social media. residentName is
// the requester's name (kept from the original column); source is where the link was shared
// (instagram, facebook, whatsapp, google, direct, or phone/walk-in for owner-added ones).
// Status runs new -> contacted -> accepted | declined; residentId links the resident it became.
model Booking {
  id           String    @id @default(cuid())
  residentName String
  phone        String    @default("")
  email        String?
  roomNumber   String    @default("")
  status       String    @default("new")
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  moveInDate   DateTime?
  foodOpted    Boolean?
  message      String    @default("")
  source       String    @default("direct")
  residentId   String?
  resident     Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  message    String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  RESIDENT
}

model SuperAdmin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

// A session belongs to exactly one user type; the nullable FKs keep referential
// integrity for both without merging residents and admins into one table.
model Session {
  id           String      @id @default(cuid())
  tokenHash    String      @unique
  role         UserRole
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  residentId   String?
  resident     Resident?   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
}

enum AadharVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum HousekeepingSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum HousekeepingStatus {
  REQUESTED
  SCHEDULED
  DONE
  CANCELLED
}

// A resident's one-off cleaning request, worked through by the owner on the Housekeeping page.
model HousekeepingRequest {
  id                     String             @id @default(cuid())
  residentId             String
  resident               Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  date                   DateTime           @db.Date
  slot                   HousekeepingSlot
  note                   String?
  status                 HousekeepingStatus @default(REQUESTED)
  // Shown to the resident, e.g. "Cleaner arrives at 10am" or why a request was cancelled.
  ownerNote              String?
  // "Cleaner did not turn up" nudges from the resident; a reminder counts as open until the owner
  // replies or changes the status after it (reminderAcknowledgedAt later than lastReminderAt).
  reminderCount          Int                @default(0)
  lastReminderAt         DateTime?
  reminderAcknowledgedAt DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status, date])
  @@index([residentId, date])
}

enum TenantType {
  MEN
  WOMEN
  COLIVING
}

// One month of rent recorded as paid by the owner. `month` is "YYYY-MM" (the month the rent is for).
model RentPayment {
  id                String   @id @default(cuid())
  residentId        String
  resident          Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  month             String
  amount            Int
  paidAt            DateTime @default(now())
  // Set when paid online through Razorpay; null means the owner recorded it (cash, UPI to owner, ...).
  razorpayPaymentId String?

  @@unique([residentId, month])
}

enum RentOrderStatus {
  CREATED
  PAID
}

// One online payment attempt: the months and amounts owed when the resident pressed Pay, frozen so
// the recorded payment matches exactly what Razorpay charged.
model RentOrder {
  id                String          @id @default(cuid())
  residentId        String
  resident          Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  // The Razorpay order id for Checkout payments, or the QR code id (qr_...) for UPI QR payments.
  razorpayOrderId   String          @unique
  amount            Int
  // [{ month: "2026-10", amount: 15000 }, ...]
  items             Json
  status            RentOrderStatus @default(CREATED)
  razorpayPaymentId String?
  createdAt         DateTime        @default(now())
  paidAt            DateTime?

  @@index([residentId])
}

// Single row (id "workspace") of owner-editable settings; defaults match the original fixed behaviour.
model WorkspaceSettings {
  id                      String    @id @default("workspace")
  businessName            String    @default("Raj Properties")
  contactPhone            String?
  contactEmail            String?
  // The owner's own UPI ID (VPA) shown to residents with rent due, plus the name UPI apps display.
  // Payments to it are not visible to the app, so residents report them for the owner to confirm.
  upiId                   String?
  upiPayeeName            String?
  // The owner's own QR image (e.g. a PhonePe/GPay/merchant QR) as a data URL; when set, residents
  // see it instead of the QR generated from upiId. The timestamp versions its URL for caching.
  upiQrUrl                String?
  upiQrUpdatedAt          DateTime?
  // Workspace logo as a data URL (resized in the browser); the timestamp versions its URL for caching.
  logoUrl                 String?
  logoUpdatedAt           DateTime?
  // Rent is due by rentDueDay; reminders show from reminder one/two day; overdue after the due day.
  rentDueDay              Int       @default(2)
  rentReminderOneDay      Int       @default(1)
  rentReminderTwoDay      Int       @default(2)
  // Housekeeping slot windows as 24-hour "HH:MM" local (IST) times.
  morningFrom             String    @default("08:00")
  morningTo               String    @default("12:00")
  afternoonFrom           String    @default("12:00")
  afternoonTo             String    @default("16:00")
  eveningFrom             String    @default("16:00")
  eveningTo               String    @default("20:00")
  // Plain-text resident policies linked from the resident portal. Null = never saved, so the
  // starter draft is used; an empty string means the owner removed it.
  termsAndConditions      String?
  privacyPolicy           String?
  // Policy versions: stamped only when the owner saves changed, non-empty text; residents must
  // accept anything newer than the version they last accepted.
  termsUpdatedAt          DateTime?
  privacyPolicyUpdatedAt  DateTime?
  // Whole rupees added to each month paid after the due day; 0 = no late fee.
  lateFee                 Int       @default(0)
  // Shown to residents; null deposit = not shown.
  securityDeposit         Int?
  noticePeriodDays        Int       @default(30)
  // House rules as "HH:MM" local times; quiet hours may run past midnight (from > to).
  visitingFrom            String    @default("10:00")
  visitingTo              String    @default("20:00")
  quietFrom               String    @default("22:00")
  quietTo                 String    @default("07:00")
  // Cleanings a resident may book per Monday–Sunday week; null = no limit.
  housekeepingWeeklyLimit Int?
  updatedAt               DateTime  @updatedAt
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

// A property's repeating weekly menu; weekday is ISO (1 = Monday … 7 = Sunday). A missing row means
// that meal has no menu set.
model MenuItem {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  weekday    Int
  meal       MealType
  items      String

  @@unique([propertyId, weekday, meal])
}

// A resident opting out of one meal on one date, so the kitchen can cook for fewer people.
model MealSkip {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  meal       MealType
  createdAt  DateTime @default(now())

  @@unique([residentId, date, meal])
}

// A resident's thumbs up/down on one served meal. propertyId is kept so feedback stays with the
// property that served the meal even if the resident later moves.
model MealFeedback {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  meal       MealType
  liked      Boolean
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([residentId, date, meal])
  @@index([propertyId, date])
}
