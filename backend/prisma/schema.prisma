generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                  String               @id @default(cuid())
  name                String
  location            String
  // City for the resident portal's weather (e.g. "Bengaluru"); location is often a map link.
  city                String?
  // Owner's phone (E.164) for residents' "Call owner" button; falls back to the workspace contact phone.
  ownerPhone          String?
  // The PG's own website, if it has one (a full https:// address); shown on the public site and in the portal's Info tab.
  websiteUrl          String?
  imageUrl            String
  status              String               @default("Healthy")
  // Meal service windows shown to residents, as 24-hour "HH:MM" local (IST) times.
  breakfastFrom       String               @default("07:30")
  breakfastTo         String               @default("09:30")
  lunchFrom           String               @default("12:30")
  lunchTo             String               @default("14:30")
  dinnerFrom          String               @default("19:30")
  dinnerTo            String               @default("21:30")
  // Who the PG is for; null only for properties created before this was asked.
  tenantType          TenantType?
  // Codes from the known amenity list (see propertyFeatures.ts), so new amenities need no migration.
  amenities           String[]             @default([])
  // Room capacity the owner declared; occupancy is measured against it. Null for older properties,
  // which fall back to the number of Room rows that exist.
  totalRooms          Int?
  // Optional pricing: when both are set, residents' rent follows their food choice (see propertyRent.ts).
  rentWithFood        Int?
  rentWithoutFood     Int?
  // Prices for particular sharing types; any sharing type without one uses the two rents above.
  sharingPrices       SharingPrice[]
  // Move-out notice in days for this property; null falls back to the notice period in Settings.
  noticePeriodDays    Int?
  // The resident Info tab (see residentInfo.ts): Wi-Fi, contacts ("Label: number" per line), times ("HH:MM").
  wifiName            String?
  wifiPassword        String?
  contacts            String?
  checkInTime         String?
  checkOutTime        String?
  gateClosingTime     String?
  rooms               Room[]
  payments            Payment[]
  // Superseded by `workers` (its names were copied there as HOUSEKEEPING) and no longer read. Kept
  // only so the previous release keeps working while this one deploys; drop it in a later migration.
  housekeepingStaff   String[]             @default([])
  // The people who work at the property (cooks, housekeeping, security…); see workers.ts.
  workers             Worker[]
  doorLockTasks       DoorLockTask[]
  lateMealRequests    LateMealRequest[]
  expenses            Expense[]
  activities          Activity[]
  maintenanceRequests MaintenanceRequest[]
  bookings            Booking[]
  announcements       Announcement[]
  fireAlerts          FireAlert[]
  menuItems           MenuItem[]
  // When the weekly menu last changed, so residents on the food plan are told.
  menuUpdatedAt       DateTime?
  // What that change was, one line per meal: "Monday lunch: veg biryani (was south indian veg meals)".
  menuChanges         String?
  mealFeedback        MealFeedback[]
  photos              PropertyPhoto[]
  createdAt           DateTime             @default(now())
}

// A property's rent for one sharing type (room size), with and without food; see propertyRent.ts.
model SharingPrice {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // 1 = single, 2 = double sharing… (matches Room.beds).
  beds            Int
  rentWithFood    Int
  rentWithoutFood Int

  @@unique([propertyId, beds])
}

model Room {
  id         String     @id @default(cuid())
  number     String
  // How many residents share the room (1 = single, 2 = double sharing…). Occupancy is counted from
  // the residents in it rather than stored, so it can never drift from who actually lives there.
  beds       Int        @default(1)
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents  Resident[]
  // Free beds held back by staff (see bedReservations.ts).
  reservations BedReservation[]

  // Room numbers are defined by the owner and must be unique within a property.
  @@unique([propertyId, number])
}

// A free bed held back by staff (e.g. for someone expected), so it is neither offered nor given to a new
// resident until released by hand (see bedReservations.ts). One hold per bed.
model BedReservation {
  id             String   @id @default(cuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber      Int
  note           String?
  reservedByName String?
  createdAt      DateTime @default(now())

  @@unique([roomId, bedNumber])
}

model Resident {
  id                       String                   @id @default(cuid())
  name                     String
  phone                    String?
  email                    String?
  // ISO 3166-1 alpha-2. Indian residents are verified on Aadhaar; everyone else on passport and
  // visa, which also feed Form C reporting to the FRRO. A resident holds one set or the other.
  nationality              String                   @default("IN")
  aadharNumber             String?
  permanentAddress         String?
  // One optional emergency contact, set by the resident or the owner; the owner calls it if something
  // happens to the resident. The phone is stored in E.164 like the resident's own.
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  // The resident's vehicle, for parking and security: type (Bike, Scooter, Car, Bicycle) and its
  // registration number, upper case. Both optional; a bicycle may have no number.
  vehicleType              String?
  vehicleNumber            String?
  // What the resident does (e.g. "Software engineer", "Student"), as they or the owner typed it.
  occupation               String?
  // False after the resident edits their own address: its "Verified" badge waits for the owner again.
  addressVerified          Boolean                  @default(true)
  aadharCardUrl            String?
  passportNumber           String?
  passportExpiry           DateTime?                @db.Date
  // Added by a receptionist and not yet approved by a super admin: the room is held, but they cannot
  // sign in. Super admins' own additions never wait.
  approvalPending          Boolean                  @default(false)
  // Scan of the passport photo page, as a data URL like aadharCardUrl.
  passportScanUrl          String?
  visaNumber               String?
  visaType                 String?
  visaExpiry               DateTime?                @db.Date
  accessKeyHash            String?
  // PIN for the resident's door lock, generated by a super admin and programmed into the lock by hand.
  // Plain text, unlike the access key: both the owner and the resident must be able to read it again.
  doorAccessKey            String?
  // When the daily run removed the door access key because rent went overdue (see doorAccessRevocation.ts),
  // so the owner is told to delete the PIN from the lock too. Cleared when a new key is issued.
  doorAccessKeyRevokedAt   DateTime?
  // Set by the resident after their first access-key sign-in; from then on the access key is retired.
  passwordHash             String?
  // Null once they have moved out, so the bed can be let again; movedOutFrom keeps where they lived.
  // Several residents share a room up to its bed count (enforced in claimRoom, residents.ts).
  roomId                   String?
  room                     Room?                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // Which bed in the room (1 to Room.beds), so staff know exactly which beds are free (see beds.ts).
  // Unique within a room; cleared with roomId when they move out.
  bedNumber                Int?
  movedOutFrom             String?
  maintenanceRequests      MaintenanceRequest[]
  active                   Boolean                  @default(true)
  // Move-in date, separate from createdAt because residents are often added after they arrive.
  joinedAt                 DateTime                 @default(now()) @db.Date
  // Overdue rent locks the resident out (see rentLock.ts) unless today is on or before this date.
  rentAccessUntil          DateTime?                @db.Date
  // "Exit PG": the resident's move-out notice (one at a time), the owner's decision, and completion.
  exitStatus               ExitStatus?
  exitDate                 DateTime?                @db.Date
  exitReason               String?
  exitRequestedAt          DateTime?
  movedOutAt               DateTime?
  // "Delete my account": when the resident asked (null when nothing is pending), when the owner last
  // declined and why (both shown to the resident until they ask again), and when the owner approved
  // it (the account is closed, with every detail kept for the owner's Deleted records).
  deletionRequestedAt      DateTime?
  deletionDeclinedAt       DateTime?
  deletionDeclineReason    String?
  deletedAt                DateTime?
  // Who closed the account when a staff member removed the resident; null when the resident asked.
  deletedByName            String?
  // Portal content stays locked until an owner approves the resident's identity documents: Aadhaar,
  // or passport and visa for non-Indians. Named before passports were supported.
  aadharStatus             AadharVerificationStatus @default(NOT_SUBMITTED)
  aadharRejectionReason    String?
  aadharSubmittedAt        DateTime?
  aadharReviewedAt         DateTime?
  // Small square JPEG (resized in the browser) stored as a data URL; the timestamp versions the
  // photo URL so browsers fetch the new one after a change instead of showing a cached copy.
  profilePhotoUrl          String?
  profilePhotoUpdatedAt    DateTime?
  // Whole rupees per month; null means rent is not tracked for this resident.
  monthlyRent              Int?
  // When rent was first set: billing starts from here, so adding rent for an existing resident
  // never produces surprise arrears for months before the owner started tracking.
  rentTrackedFrom          DateTime?
  // Food plan chosen by the owner; residents without it get no menu, skips, or headcount entry.
  foodOpted                Boolean                  @default(true)
  // Veg or non-veg, for the kitchen's headcount split; null until someone chooses ("Not set"), so
  // nobody is counted as either by default.
  diet                     Diet?
  // Set when a resident without food asks to join the food plan; cleared when the owner decides.
  foodRequestedAt          DateTime?
  // The owner's last decision on a food request, so the resident is told: when, and approved or not.
  foodDecidedAt            DateTime?
  foodApproved             Boolean?
  sessions                 Session[]
  housekeepingRequests     HousekeepingRequest[]
  doorLockTasks            DoorLockTask[]
  lateMealRequests         LateMealRequest[]
  rentPayments             RentPayment[]
  payments                 Payment[]
  bookings                 Booking[]                @relation("bookingResident")
  // Bookings made through this resident's referral link, and the rent concessions they earned.
  referredBookings         Booking[]                @relation("bookingReferrer")
  rentConcessions          RentConcession[]         @relation("concessionHolder")
  referralRewards          RentConcession[]         @relation("concessionReferral")
  // The code in this resident's "Refer a friend" link (?ref=…), made the first time they open the portal.
  referralCode             String?                  @unique
  // WhatsApp updates (rent reminders, receipts, notices); on by default, the resident can turn it off.
  whatsappOptIn            Boolean                  @default(true)
  outboundMessages         OutboundMessage[]
  // Email updates (reminders, notices); on by default. Receipts are sent regardless: they are records.
  emailOptIn               Boolean                  @default(true)
  rentOrders               RentOrder[]
  mealChoices              MealChoice[]
  // The policy version (latest update timestamp) this resident accepted, and when they did.
  policiesAcceptedVersion  DateTime?
  policiesAcceptedAt       DateTime?
  mealFeedback             MealFeedback[]
  passkeys                 ResidentPasskey[]
  createdAt                DateTime                 @default(now())

  @@index([roomId])
  // One resident per bed. Moved-out residents have no room (and no bed), and nulls never clash.
  @@unique([roomId, bedNumber])
}

// A payment the owner records by hand. Amount is in whole rupees. Payer name and phone are copied
// from the resident at entry time (and editable), so the record still reads correctly after the
// resident moves out or their details change; residentId is only a link back.
model Payment {
  id                String    @id @default(cuid())
  amount            Int
  status            String    @default("paid")
  payerName         String    @default("")
  phone             String    @default("")
  bankName          String    @default("")
  method            String    @default("cash")
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residentId        String?
  resident          Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  // Set when the payment is collected through a Razorpay UPI QR code; Razorpay then decides the
  // status (paid on credit, failed when the code closes unpaid), not the owner.
  razorpayQrId      String?   @unique
  qrImageUrl        String?
  qrExpiresAt       DateTime?
  razorpayPaymentId String?
  // A resident's "I've paid" report for a payment to the owner's UPI ID: the UPI reference (UTR)
  // they entered, and the rent months it covers ([{ month, amount }]), recorded when the owner
  // marks it paid.
  reference         String    @default("")
  rentMonths        Json?
  createdAt         DateTime  @default(now())
}

// A resident's complaint or repair request (status: open, in_progress, resolved).
model MaintenanceRequest {
  id         String    @id @default(cuid())
  title      String
  status     String    @default("open")
  // plumbing, electrical, wifi, furniture, cleaning, appliance, other.
  category   String    @default("other")
  details    String    @default("")
  // Optional photo as a data URL (resized in the browser).
  photoUrl   String?
  // The owner's reply, shown to the resident.
  ownerNote  String?
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  resolvedAt DateTime?

  @@index([residentId])
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String
  amountLabel String
  timeLabel   String
  tone        String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// A booking request, mostly from the public /book form shared on social media. residentName is
// the requester's name (kept from the original column); source is where the link was shared
// (instagram, facebook, whatsapp, google, direct, or phone/walk-in for owner-added ones).
// Status runs new -> contacted -> accepted | declined; residentId links the resident it became.
model Booking {
  id                 String    @id @default(cuid())
  residentName       String
  phone              String    @default("")
  email              String?
  roomNumber         String    @default("")
  status             String    @default("new")
  propertyId         String
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  moveInDate         DateTime?
  foodOpted          Boolean?
  message            String    @default("")
  source             String    @default("direct")
  residentId         String?
  resident           Resident? @relation("bookingResident", fields: [residentId], references: [id], onDelete: SetNull)
  // The resident whose referral link brought this request in, if any; their friend joining earns them a reward.
  referrerResidentId String?
  referrer           Resident? @relation("bookingReferrer", fields: [referrerResidentId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  message    String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// A fire alarm for one property, raised by the owner or a resident; active until an owner clears it.
model FireAlert {
  id                 String    @id @default(cuid())
  propertyId         String
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Who raised it, as shown on the alarm ("Property owner" or the resident's name).
  raisedByName       String
  raisedByResidentId String?
  createdAt          DateTime  @default(now())
  clearedAt          DateTime?

  @@index([propertyId, clearedAt])
}

/// A resident's diet, as the kitchen plans for it.
enum Diet {
  VEG
  NON_VEG
}

enum ExitStatus {
  PENDING
  APPROVED
  DECLINED
}

enum UserRole {
  SUPER_ADMIN
  RESIDENT
}

// Identity details are nullable because admins created before they were collected (and by the
// bootstrap script) have none; the API requires them for every admin added from the dashboard.
model SuperAdmin {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  phone            String?
  // One ID document by nationality, like residents: Aadhaar for Indian nationals, passport otherwise.
  aadharNumber     String?
  passportNumber   String?
  sex              Sex?
  // ISO 3166-1 alpha-2 code (e.g. "IN"); names and flags are derived from it on the client.
  nationality      String?
  permanentAddress String?
  // SUPER_ADMIN: the owner, everything. RECEPTIONIST: day-to-day work (residents, requests, payments, food,
  // announcements) for the properties in propertyIds only; no settings, views, team or deletions.
  staffRole        StaffRole @default(SUPER_ADMIN)
  propertyIds      String[]  @default([])
  sessions         Session[]
  subscriptions    StaffSubscription[]
  createdAt        DateTime  @default(now())
}

// A receptionist's paid period, recorded by a super admin. Each renewal is a new row, so the rows are
// the history; the one ending last is the current subscription. Once its endsOn has passed (India
// time) the receptionist cannot sign in. Receptionists with no rows are not restricted, so accounts
// that predate subscriptions keep working until one is added.
model StaffSubscription {
  id        String     @id @default(cuid())
  staffId   String
  staff     SuperAdmin @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // Free text from the form's choices (Monthly, Quarterly, Half-yearly, Yearly) or the owner's own.
  plan      String
  // Inclusive calendar days: the subscription covers the whole of endsOn.
  startsOn  DateTime   @db.Date
  endsOn    DateTime   @db.Date
  // Whole rupees paid for this period.
  amount    Int
  note      String?
  // The day a super admin used End now. Access stopped that day, so the period's last day is the day
  // before (or endsOn, if earlier). The dates and amount stay as recorded.
  endedEarlyOn DateTime? @db.Date
  createdAt DateTime   @default(now())

  @@index([staffId, endsOn])
}

enum StaffRole {
  SUPER_ADMIN
  RECEPTIONIST
}

enum DoorLockAction {
  ADD
  DELETE
}

// A PIN change the owner must make on the physical lock by hand: the lock (Qubo) has no API the app
// can reach, so every door access key issued or cleared queues one of these (see doorLockTasks.ts).
// Names are copied in so the task still reads correctly after the resident or property is gone.
model DoorLockTask {
  id           String         @id @default(cuid())
  action       DoorLockAction
  pin          String
  residentId   String?
  resident     Resident?      @relation(fields: [residentId], references: [id], onDelete: SetNull)
  residentName String
  propertyId   String?
  property     Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyName String?
  // Why it is needed, in plain words: "New key issued", "Rent overdue", "Moved out"…
  reason       String
  createdAt    DateTime       @default(now())
  // Set when the owner confirms the change was made on the lock.
  doneAt       DateTime?
  doneByName   String?

  @@index([doneAt, createdAt])
  @@index([residentId, action, pin])
}

// What a property worker does. Only housekeeping names are shown to the property's residents.
enum WorkerRole {
  HEAD_COOK
  HELPING_COOK
  HOUSEKEEPING
  SECURITY
  ELECTRICIAN
  PLUMBER
}

// Someone who works at a property but never signs in. Named "worker" rather than "staff" because staff
// in this codebase means the people who use the dashboard (super admins and receptionists).
model Worker {
  id             String     @id @default(cuid())
  propertyId     String
  property       Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  role           WorkerRole
  // E.164 (see validation.ts). Required by the API; null only for housekeeping names carried over
  // from the old name list, which had no phone.
  phone          String?
  // 256×256 JPEG data URL, resized in the browser; served by its own route so lists stay small.
  photoUrl       String?
  photoUpdatedAt DateTime?
  // Date of joining (calendar day only). Required by the API; null only for staff added before it existed.
  joinedOn       DateTime?  @db.Date
  createdAt      DateTime   @default(now())

  @@index([propertyId, role])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

// A session belongs to exactly one user type; the nullable FKs keep referential
// integrity for both without merging residents and admins into one table.
model Session {
  id           String      @id @default(cuid())
  tokenHash    String      @unique
  role         UserRole
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  residentId   String?
  resident     Resident?   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
}

enum AadharVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum HousekeepingSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum HousekeepingStatus {
  REQUESTED
  SCHEDULED
  DONE
  CANCELLED
}

// A resident's one-off cleaning request, worked through by the owner on the Housekeeping page.
model HousekeepingRequest {
  id                     String             @id @default(cuid())
  residentId             String
  resident               Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  date                   DateTime           @db.Date
  slot                   HousekeepingSlot
  note                   String?
  status                 HousekeepingStatus @default(REQUESTED)
  // Shown to the resident, e.g. "Cleaner arrives at 10am" or why a request was cancelled.
  ownerNote              String?
  // "Cleaner did not turn up" nudges from the resident; a reminder counts as open until the owner
  // replies or changes the status after it (reminderAcknowledgedAt later than lastReminderAt).
  reminderCount          Int                @default(0)
  lastReminderAt         DateTime?
  reminderAcknowledgedAt DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status, date])
  @@index([residentId, date])
}

enum TenantType {
  MEN
  WOMEN
  COLIVING
}

// One month of rent recorded as paid by the owner. `month` is "YYYY-MM" (the month the rent is for).
model RentPayment {
  id                String   @id @default(cuid())
  residentId        String
  resident          Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  month             String
  amount            Int
  paidAt            DateTime @default(now())
  // Set when paid online through Razorpay; null means the owner recorded it (cash, UPI to owner, ...).
  razorpayPaymentId String?

  @@unique([residentId, month])
}

enum RentOrderStatus {
  CREATED
  PAID
}

// One online payment attempt: the months and amounts owed when the resident pressed Pay, frozen so
// the recorded payment matches exactly what Razorpay charged.
model RentOrder {
  id                String          @id @default(cuid())
  residentId        String
  resident          Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  // The Razorpay order id for Checkout payments, or the QR code id (qr_...) for UPI QR payments.
  razorpayOrderId   String          @unique
  amount            Int
  // [{ month: "2026-10", amount: 15000 }, ...]
  items             Json
  status            RentOrderStatus @default(CREATED)
  razorpayPaymentId String?
  createdAt         DateTime        @default(now())
  paidAt            DateTime?

  @@index([residentId])
}

// Single row (id "workspace") of owner-editable settings; defaults match the original fixed behaviour.
model WorkspaceSettings {
  id                      String        @id @default("workspace")
  businessName            String        @default("Raj Properties")
  contactPhone            String?
  contactEmail            String?
  // The owner's own UPI ID (VPA) shown to residents with rent due, plus the name UPI apps display.
  // Payments to it are not visible to the app, so residents report them for the owner to confirm.
  upiId                   String?
  upiPayeeName            String?
  // Smart lock. Off hides door access keys everywhere; it can only be switched off once no resident
  // holds a key and no Door locks task is pending, so no PIN is left on the lock unseen.
  doorKeysEnabled         Boolean       @default(true)
  // Which lock and where (e.g. "Qubo Select SDL-P3", "Main gate"), shown on the Door locks page.
  lockModel               String?
  lockLocation            String?
  // Digits in each new PIN, to match what the lock accepts; existing PINs keep their length.
  doorPinLength           Int           @default(6)
  // How to open the door, shown to residents next to their PIN.
  doorUnlockInstructions  String?
  // The owner's own QR image (e.g. a PhonePe/GPay/merchant QR) as a data URL; when set, residents
  // see it instead of the QR generated from upiId. The timestamp versions its URL for caching.
  upiQrUrl                String?
  upiQrUpdatedAt          DateTime?
  // Workspace logo as a data URL (resized in the browser); the timestamp versions its URL for caching.
  logoUrl                 String?
  logoUpdatedAt           DateTime?
  // Rent is due by rentDueDay; reminders show from reminder one/two/three day; overdue (and the
  // resident locked out) after the due day.
  rentDueDay              Int           @default(3)
  rentReminderOneDay      Int           @default(1)
  rentReminderTwoDay      Int           @default(2)
  rentReminderThreeDay    Int           @default(3)
  // Housekeeping slot windows as 24-hour "HH:MM" local (IST) times.
  morningFrom             String        @default("08:00")
  morningTo               String        @default("12:00")
  afternoonFrom           String        @default("12:00")
  afternoonTo             String        @default("16:00")
  eveningFrom             String        @default("16:00")
  eveningTo               String        @default("20:00")
  // Plain-text resident policies linked from the resident portal. Null = never saved, so the
  // starter draft is used; an empty string means the owner removed it.
  termsAndConditions      String?
  privacyPolicy           String?
  // Policy versions: stamped only when the owner saves changed, non-empty text; residents must
  // accept anything newer than the version they last accepted.
  termsUpdatedAt          DateTime?
  privacyPolicyUpdatedAt  DateTime?
  // Whole rupees added to each month paid after the due day; 0 = no late fee.
  lateFee                 Int           @default(0)
  // Shown to residents; null deposit = not shown.
  securityDeposit         Int?
  noticePeriodDays        Int           @default(30)
  // Per-day rates for the move-out month (days from the 1st x rate, capped at the month's rent).
  dailyRateWithFood       Int           @default(1250)
  dailyRateWithoutFood    Int           @default(750)
  // The owner's own house rules (one per line) and FAQs (blocks, question first), shown under Info.
  extraHouseRules         String        @default("")
  faqs                    String        @default("")
  // House rules as "HH:MM" local times; quiet hours may run past midnight (from > to).
  visitingFrom            String        @default("10:00")
  visitingTo              String        @default("20:00")
  quietFrom               String        @default("22:00")
  quietTo                 String        @default("07:00")
  // Cleanings a resident may book per Monday–Sunday week; null = no limit.
  housekeepingWeeklyLimit Int?
  // Most late meal requests staff may approve for one meal (e.g. Tuesday dinner) at one property, so the
  // kitchen never gets more unplanned extras than it can cook for (see lateMeals.ts).
  lateMealLimit           Int           @default(10)
  // The resident portal's light/dark view, set by the owner: AUTO = light 7am–7pm, dark otherwise.
  residentTheme           ResidentTheme @default(AUTO)
  // The resident portal's theme colour, the text colour on things filled with it, error messages and
  // general text and input placeholders (light view), as "#rrggbb"; null = the defaults (sky blue,
  // white, brick red, charcoal, soft grey).
  portalThemeColor        String?
  portalButtonTextColor   String?
  portalErrorColor        String?
  portalTextColor         String?
  portalPlaceholderColor  String?
  // Colours of the "New", "Coming soon" and "Beta" banners on cards, "#rrggbb"; null = the defaults
  // (red, amber, red).
  portalNewBadgeColor     String?
  portalSoonBadgeColor    String?
  portalBetaBadgeColor    String?
  // The page background behind the cards (light view), "#rrggbb"; null = white for residents and the
  // admin's usual background.
  portalBackgroundColor   String?
  // Backgrounds of the main section cards and of the small cards inside them (light view), "#rrggbb";
  // null = the defaults (white, and the theme colour's light tint in the resident portal).
  portalCardColor         String?
  portalChildCardColor    String?
  // Which banner each resident feature shows: { feature: "NEW" | "SOON" | "BETA" }; a feature left out
  // shows none. Starts as the banners the portal had before the owner could choose.
  // The owner's own text for the public website and the sections they turned off (see siteContent.ts);
  // null keeps the built-in text and every section.
  siteContent             Json?
  // The website's full-screen banner image (data URL) and when it changed, to version its public URL;
  // without one the banner shows the theme-colour gradient.
  siteBannerUrl           String?
  siteBannerUpdatedAt     DateTime?
  featureBadges           Json          @default("{\"faqs\":\"NEW\",\"passkeys\":\"NEW\",\"whatsapp\":\"BETA\",\"email\":\"BETA\"}")
  updatedAt               DateTime      @updatedAt
}

enum ResidentTheme {
  AUTO
  LIGHT
  DARK
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

// A property's repeating weekly menu; weekday is ISO (1 = Monday … 7 = Sunday). A missing row means
// that meal has no menu set.
model MenuItem {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  weekday    Int
  meal       MealType
  items      String

  @@unique([propertyId, weekday, meal])
}

// A resident's answer for one meal on one date, given by 9 pm the day before. A meal with no answer
// counts as not eating (from the date in food.ts), so the kitchen cooks only for confirmed residents.
enum LateMealStatus {
  PENDING
  APPROVED
  DECLINED
}

// A resident asking to eat a meal after its 9 pm-the-day-before cutoff (and before it starts). Staff
// approve or decline it; approving sets the resident's MealChoice to eating, so the headcount counts
// them. One per resident, day and meal, so a declined request is final (see lateMeals.ts).
model LateMealRequest {
  id            String         @id @default(cuid())
  residentId    String
  resident      Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date          DateTime       @db.Date
  meal          MealType
  status        LateMealStatus @default(PENDING)
  // Shown to the resident with the decision, e.g. "Sorry, nothing left".
  staffNote     String?
  decidedAt     DateTime?
  decidedByName String?
  createdAt     DateTime       @default(now())

  @@unique([residentId, date, meal])
  @@index([propertyId, date])
}

model MealChoice {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  meal       MealType
  eating     Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([residentId, date, meal])
}

// A resident's thumbs up/down on one served meal. propertyId is kept so feedback stays with the
// property that served the meal even if the resident later moves.
model MealFeedback {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  meal       MealType
  liked      Boolean
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([residentId, date, meal])
  @@index([propertyId, date])
}

// One message the app sent (or tried to), by WhatsApp or email. dedupeKey names the event it was
// for (e.g. "rent:<resident>:2026-10:reminder1"; email keys start "email:"), so a re-run of the
// daily job never sends it twice; a failed attempt may be retried under the same key. `to` is the
// phone (91XXXXXXXXXX) or email address; `kind` is the WhatsApp template or email type.
model OutboundMessage {
  id                String    @id @default(cuid())
  channel           String    @default("whatsapp")
  residentId        String?
  resident          Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  to                String
  kind              String
  dedupeKey         String?   @unique
  status            String    @default("pending")
  providerMessageId String?
  error             String?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([channel, createdAt])
}

// Money the owner spends running the PGs, for the Payments page's monthly profit/loss. Whole
// rupees. date is a calendar day (UTC midnight, like joining dates); propertyId is optional, since
// some costs (e.g. an accountant) are shared across properties.
model Expense {
  id         String    @id @default(cuid())
  category   String
  amount     Int
  date       DateTime
  note       String    @default("")
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([date])
}

// A passkey a resident saved on their phone to sign in with Face ID, Touch ID or a fingerprint. Only
// the public key is stored; the biometric check happens on the device and never reaches the server.
// counter is the authenticator's signature count, kept to spot a cloned key.
model ResidentPasskey {
  id           String    @id @default(cuid())
  residentId   String
  resident     Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  // Which device it is on, from the browser ("iPhone", "Android"), so the resident can tell keys apart.
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([residentId])
}

// A discount on one month's rent for one resident, as a percentage of that month's rent. Earned by
// referring a friend who joins and pays their first rent (referredResidentId, once per friend); the
// owner can cancel it until that month is paid. Every place that prices a month applies it (rent.ts).
model RentConcession {
  id                 String           @id @default(cuid())
  residentId         String
  resident           Resident         @relation("concessionHolder", fields: [residentId], references: [id], onDelete: Cascade)
  // "YYYY-MM": the month it comes off.
  month              String
  percent            Int
  reason             String
  referredResidentId String?          @unique
  referredResident   Resident?        @relation("concessionReferral", fields: [referredResidentId], references: [id], onDelete: SetNull)
  status             ConcessionStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())

  @@index([residentId])
}

enum ConcessionStatus {
  ACTIVE
  CANCELLED
}

// The owner's gallery of a property (rooms, dining hall, outside), shown to its residents. Images are
// resized in the browser and stored as data URLs like the property's main image; at most 12 per
// property, oldest first.
model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  imageUrl   String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

// The audit log: every change a staff member saved (see staffActivity.ts). Receptionists' entries
// also appear in the super admins' notifications.
model StaffActivity {
  id           String   @id @default(cuid())
  staffId      String
  staffName    String
  // SUPER_ADMIN or RECEPTIONIST at the time of the change.
  staffRole    String   @default("RECEPTIONIST")
  action       String
  // The property the change was about, when it was about one (kept by name so deleted ones still read).
  propertyId   String?
  propertyName String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
