PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Used once by `npm run create-super-admin` to bootstrap the first super admin.
SUPER_ADMIN_NAME="Super admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Razorpay online rent payments (Dashboard -> Account & Settings -> API Keys). Start with test-mode
# keys (rzp_test_...). Leave blank to switch online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<your-backend>/api/razorpay/webhook, events payment.captured, order.paid and qr_code.credited (UPI QR; also enable QR Codes on the account).
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Platform (Cloud API): Meta developer console -> your app -> WhatsApp -> API setup.
# Use a permanent System User token (Business settings -> System users), not the 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Language code the message templates were approved in (default "en").
WHATSAPP_TEMPLATE_LANGUAGE=en
# Secret for the daily rent-reminder call (cron-job.org -> /api/cron/rent-reminders, header x-cron-key).
CRON_SECRET=

# Email through Resend (resend.com -> API Keys). EMAIL_FROM must be on a domain verified in Resend;
# without it, Resend's test sender only delivers to your own Resend account address.
RESEND_API_KEY=
EMAIL_FROM=
# Public address of the web app, used for links in emails (default https://raj-pg.netlify.app).
APP_URL=

# Live cricket in the resident portal (cricketdata.org). Free plan: 100 calls/day, so keep the
# refresh at 15 minutes; a paid key can use 1. Leave blank to hide the score card.
CRICKET_API_KEY=
CRICKET_REFRESH_MINUTES=15
